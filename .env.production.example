# Production settings for Churu Poll Day Monitoring. Copy to .env.production (chmod 600). NEVER commit it.
# Easiest: ./deploy/make-env.sh poll.vultusgo.in  -> writes .env.production with fresh random secrets.
# Read by docker-compose.prod.yml for BOTH containers (app and db).

# --- App ---
# Always production on the server (secure cookies, HSTS).
NODE_ENV=production
# Port inside the container. The host side is fixed in docker-compose.prod.yml: 127.0.0.1:3200.
PORT=3200
# The exact public URL, https, no trailing slash. Writes from any other origin are refused.
APP_ORIGIN=https://poll.vultusgo.in
# Signs the session cookie. At least 32 random characters.
SESSION_SECRET=
# Minutes of inactivity before a session ends (5-240), and the hard limit after login (1-24 hours).
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=20
# 1 = trust exactly one proxy hop: the host nginx. (Docker NAT shows the bridge IP, so "loopback"
# would make every officer look like one IP.) Never "true".
TRUST_PROXY=1
# Poll day (YYYY-MM-DD). Used by `npm run seed:steps` and until the admin saves a date in सेटिंग.
POLL_DATE=2026-11-12
# Built frontend inside the image. Leave as is.
FRONTEND_DIST=../frontend/dist
# Login attempts per IP per 15 minutes. Officers share mobile-carrier IPs, so keep it generous;
# each account still locks for 15 min after 5 wrong passwords.
LOGIN_RATE_LIMIT_PER_15MIN=300
# true ONLY for a presentation with demo data (npm run demo:poll). Before real use:
#   npm run demo:poll -- --reset   and set this back to false (then: up -d to restart the app).
DEMO_ALLOWED=false

# --- Database (the churu-poll-db container; never reachable from outside) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=churu_poll
# Required by the MySQL init script (created, unused in production). Must end with _test.
DB_NAME_TEST=churu_poll_test
# Runtime user: only SELECT/INSERT/UPDATE/DELETE per table; audit tables insert-only.
DB_APP_USER=churu_poll_app
DB_APP_PASSWORD=
# Schema changes and grants only (npm run migrate). Never used by the running server.
DB_MIGRATION_USER=churu_poll_migrator
DB_MIGRATION_PASSWORD=
# MySQL root password of the container (backups use it).
MYSQL_ROOT_PASSWORD=
