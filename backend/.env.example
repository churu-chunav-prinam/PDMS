# Copy to backend/.env and fill in. NEVER commit backend/.env.
# Also read by docker-compose (env_file) to create the MySQL databases and users.
# Generate strong values with:  openssl rand -base64 24 | tr -d '/+='

# --- App ---
NODE_ENV=development
PORT=3200
# Signs the session cookie; at least 32 random chars (openssl rand -base64 48)
SESSION_SECRET=
# Exact origin the browser uses (dev with Vite: http://localhost:5174)
APP_ORIGIN=http://localhost:5174
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=20
# false (no proxy), loopback (proxy on this server) or a hop count. Never true.
TRUST_PROXY=false
# Poll day (YYYY-MM-DD); seed:steps places the step times on this date
POLL_DATE=2026-11-12
# Built frontend folder, relative to backend/. Missing = API only.
FRONTEND_DIST=../frontend/dist

# --- Database (Docker MySQL on the host, port 3308) ---
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=churu_poll
DB_NAME_TEST=churu_poll_test
DB_APP_USER=churu_poll_app
DB_APP_PASSWORD=
DB_MIGRATION_USER=churu_poll_migrator
DB_MIGRATION_PASSWORD=
# TLS CA certificate (PEM text or file path). Empty for local Docker; required for Aiven.
DB_SSL_CA=
# Aiven fallbacks ONLY (see docs/DEPLOY-RENDER.md). Keep false.
DB_FALLBACK_ADMIN_AS_APP_USER=false
DB_FALLBACK_NO_APPEND_ONLY_TRIGGERS=false

# --- Docker only ---
MYSQL_ROOT_PASSWORD=

# Login attempts per IP per 15 min (officers share carrier IPs; per-account lockout is the main defence)
LOGIN_RATE_LIMIT_PER_15MIN=300
# true only for a presentation on production; must be false (and demo:poll -- --reset run) before real use
DEMO_ALLOWED=false
