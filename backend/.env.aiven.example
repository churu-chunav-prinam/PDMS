# Settings for running the SETUP scripts from your laptop against Aiven MySQL.
# Copy to backend/.env.aiven (gitignored, NEVER commit) and fill in. Use with:
#   cd backend && ENV_FILE=.env.aiven npm run <script>
# Values marked (same as Render) must match the Render environment exactly.

NODE_ENV=production
PORT=3200
# (same as Render) your Render URL, e.g. https://pdms-xxxx.onrender.com
APP_ORIGIN=https://CHANGE-ME.onrender.com
# Any 32+ random chars (not used by the scripts, but required by the config check)
SESSION_SECRET=
TRUST_PROXY=1
# (same as Render) poll day; seed:steps places step times on this date
POLL_DATE=2026-11-12
FRONTEND_DIST=../frontend/dist
# true lets `npm run demo:poll` fill demo data. Set false (and run demo:poll -- --reset) before real use.
DEMO_ALLOWED=true

# --- Aiven MySQL (Aiven console -> service -> Overview -> Connection information) ---
DB_HOST=CHANGE-ME.aivencloud.com
DB_PORT=12345
DB_NAME=churu_poll
DB_NAME_TEST=churu_poll_test
# Admin user: creates the database, the app user, tables and grants. Laptop only: NEVER put
# these two on Render.
DB_MIGRATION_USER=avnadmin
DB_MIGRATION_PASSWORD=
# Least-privilege runtime user, created by `npm run db:init` (12+ chars password, you choose it)
DB_APP_USER=churu_poll_app
DB_APP_PASSWORD=
# Path to the CA certificate downloaded from Aiven (or paste the PEM text)
DB_SSL_CA=./aiven-ca.pem

# Fallbacks ONLY if `npm run db:init` reports that Aiven refused them (it tells you which):
# true => set DB_APP_USER=avnadmin and DB_APP_PASSWORD=<avnadmin password>
DB_FALLBACK_ADMIN_AS_APP_USER=false
# true => audit tables are not protected by append-only triggers
DB_FALLBACK_NO_APPEND_ONLY_TRIGGERS=false
